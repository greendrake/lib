    },
    "prettier": "@greendrake/dev-config/prettier",
    "dependencies": {
        "@greendrake/rpc-server": "workspace:*",
        "@greendrake/server": "workspace:*",
        "@greendrake/service-state": "workspace:*",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@greendrake/dev-config": "workspace:*",
        "@greendrake/rpc": "workspace:*",
        "@types/bun": "^1.3.5",
        "typescript": "6.0.3"
    }
}
