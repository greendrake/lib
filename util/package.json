{
    "name": "@greendrake/util",
    "version": "0.2.0",
    "description": "Framework-free, Node-safe utilities: typed event emitter, timing, retry, staleness, comparators, fetch helpers, misc",
    "license": "MIT",
    "author": "Eugene Greendrake <eugene@greendrake.nz>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/greendrake/lib.git",
        "directory": "util"
    },
    "homepage": "https://github.com/greendrake/lib/tree/main/util#readme",
    "bugs": {
        "url": "https://github.com/greendrake/lib/issues"
    },
    "type": "module",
    "main": "src/main.ts",
    "types": "src/main.ts",
    "exports": {
        ".": {
            "types": "./src/main.ts",
            "default": "./src/main.ts"
        },
        "./browser": {
            "types": "./src/browser.ts",
            "default": "./src/browser.ts"
        }
    },
    "files": [
        "src"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "check": "tsc --noEmit"
    },
    "prettier": "@greendrake/dev-config/prettier",
    "devDependencies": {
        "@greendrake/dev-config": "workspace:*",
        "typescript": "6.0.3"
    }
}
