{
    "name": "@greendrake/scss-kit",
    "version": "0.4.0",
    "description": "Framework-free SCSS primitives: breakpoints (single-sourced with TS via codegen), z-layer map, icon-mask registry, @font-face generator, misc mixins",
    "license": "MIT",
    "author": "Eugene Greendrake <eugene@greendrake.nz>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/greendrake/lib.git",
        "directory": "scss-kit"
    },
    "homepage": "https://github.com/greendrake/lib/tree/main/scss-kit#readme",
    "bugs": {
        "url": "https://github.com/greendrake/lib/issues"
    },
    "type": "module",
    "main": "_index.scss",
    "exports": {
        ".": {
            "sass": "./_index.scss",
            "default": "./_index.scss"
        },
        "./breakpoints": {
            "types": "./src/breakpoints.ts",
            "default": "./src/breakpoints.ts"
        }
    },
    "files": [
        "_index.scss",
        "_breakpoints.scss",
        "_lookup.scss",
        "_z.scss",
        "_icons.scss",
        "_font-face.scss",
        "_mixins.scss",
        "src"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "generate": "bun scripts/generate.ts",
        "check": "tsc --noEmit"
    },
    "prettier": "@greendrake/dev-config/prettier",
    "devDependencies": {
        "@greendrake/dev-config": "workspace:*",
        "@types/bun": "^1.3.5",
        "typescript": "6.0.3"
    }
}
