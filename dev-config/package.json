{
    "name": "@greendrake/dev-config",
    "version": "0.4.0",
    "description": "TypeScript and Prettier configuration for Vue 3 + Vite projects, as config files to extend or re-export rather than option sets to copy",
    "license": "MIT",
    "author": "Eugene Greendrake <eugene@greendrake.nz>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/greendrake/lib.git",
        "directory": "dev-config"
    },
    "homepage": "https://github.com/greendrake/lib/tree/main/dev-config#readme",
    "bugs": {
        "url": "https://github.com/greendrake/lib/issues"
    },
    "type": "module",
    "exports": {
        "./tsconfig/base.json": "./tsconfig/base.json",
        "./tsconfig/vue.json": "./tsconfig/vue.json",
        "./tsconfig/node.json": "./tsconfig/node.json",
        "./tsconfig/strict.json": "./tsconfig/strict.json",
        "./prettier": "./prettier.config.js"
    },
    "files": [
        "tsconfig",
        "prettier.config.js"
    ],
    "publishConfig": {
        "access": "public"
    },
    "prettier": "./prettier.config.js",
    "peerDependencies": {
        "typescript": "^6"
    }
}
