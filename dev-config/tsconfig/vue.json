{
    "extends": "./base.json",
    "compilerOptions": {
        "jsx": "preserve",
        "jsxImportSource": "vue"
    },
    "vueCompilerOptions": {
        "strictTemplates": true,
        // strictTemplates rejects data-* attributes by default; they are
        // standard HTML, and components carry them. This must live in the
        // shared config: a package consuming a component library's source
        // type-checks its SFCs under its own vueCompilerOptions.
        "dataAttributes": ["data-*"]
    }
}
