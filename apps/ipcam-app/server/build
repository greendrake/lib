#!/bin/bash
# Builds ./ipcam-app with the app's web half (../web) baked in: a static binary for
# this machine. bake's flags pass through: -target <os>/<arch> builds for another,
# -version <version> stamps the version it reports, -o <file> writes another file.
set -euo pipefail
cd "$(dirname "$0")"
exec go run greendrake.nz/go/spa/cmd/bake -app ../web -o ipcam-app "$@" ./cmd/ipcam-app
