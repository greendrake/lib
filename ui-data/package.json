{
    "name": "@greendrake/ui-data",
    "version": "0.10.0",
    "description": "Data-heavy dashboard components: virtualized InfiniteScrollTable, CrudPanel/MasterDetail, record editing and the admin-CRUD kit",
    "license": "MIT",
    "author": "Eugene Greendrake <eugene@greendrake.nz>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/greendrake/lib.git",
        "directory": "ui-data"
    },
    "homepage": "https://github.com/greendrake/lib/tree/main/ui-data#readme",
    "bugs": {
        "url": "https://github.com/greendrake/lib/issues"
    },
    "type": "module",
    "main": "src/main.ts",
    "types": "src/main.ts",
    "exports": {
        ".": {
            "types": "./src/main.ts",
            "default": "./src/main.ts"
        },
        "./formatters": {
            "types": "./src/formatters.ts",
            "default": "./src/formatters.ts"
        },
        "./money": {
            "types": "./src/money.ts",
            "default": "./src/money.ts"
        },
        "./e2e": {
            "types": "./e2e/table.ts",
            "default": "./e2e/table.ts"
        }
    },
    "files": [
        "src",
        "e2e"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "check": "vue-tsc --noEmit"
    },
    "prettier": "@greendrake/dev-config/prettier",
    "dependencies": {
        "@greendrake/scss-kit": "workspace:^",
        "@greendrake/ui": "workspace:^",
        "@greendrake/util": "workspace:^"
    },
    "peerDependencies": {
        "@playwright/test": ">=1.49.0",
        "vue": "^3.5.34"
    },
    "peerDependenciesMeta": {
        "@playwright/test": {
            "optional": true
        }
    },
    "devDependencies": {
        "@greendrake/dev-config": "workspace:*",
        "@playwright/test": "1.60.0",
        "@types/bun": "^1.3.5",
        "@types/jsdom": "28.0.3",
        "jsdom": "28.1.0",
        "typescript": "6.0.3",
        "vue": "^3.5.34",
        "vue-tsc": "^2.2.0"
    }
}
