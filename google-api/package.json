{
    "name": "@greendrake/google-api",
    "version": "0.1.0",
    "description": "Google APIs for bun with a service account: the JWT-bearer exchange behind any Google API, and a Search Console client with its readings — sites, sitemaps, search performance over a window, a URL's index status",
    "license": "MIT",
    "author": "Eugene Greendrake <eugene@greendrake.nz>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/greendrake/lib.git",
        "directory": "google-api"
    },
    "homepage": "https://github.com/greendrake/lib/tree/main/google-api#readme",
    "bugs": {
        "url": "https://github.com/greendrake/lib/issues"
    },
    "type": "module",
    "main": "src/main.ts",
    "types": "src/main.ts",
    "exports": {
        ".": {
            "types": "./src/main.ts",
            "default": "./src/main.ts"
        }
    },
    "files": [
        "src"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "check": "tsc --noEmit"
    },
    "prettier": "@greendrake/dev-config/prettier",
    "dependencies": {
        "@greendrake/util": "workspace:^"
    },
    "devDependencies": {
        "@greendrake/dev-config": "workspace:*",
        "@types/bun": "^1.3.5",
        "typescript": "6.0.3"
    }
}
