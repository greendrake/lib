{
    "name": "@greendrake/upload",
    "version": "0.1.0",
    "description": "File transfer over XHR: uploads to a URL the server hands out, with progress, retry and abort, blob downloads with progress, save-to-disk; a Vue multi-file uploader component via ./vue",
    "license": "MIT",
    "author": "Eugene Greendrake <eugene@greendrake.nz>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/greendrake/lib.git",
        "directory": "upload"
    },
    "homepage": "https://github.com/greendrake/lib/tree/main/upload#readme",
    "bugs": {
        "url": "https://github.com/greendrake/lib/issues"
    },
    "type": "module",
    "main": "src/main.ts",
    "types": "src/main.ts",
    "exports": {
        ".": {
            "types": "./src/main.ts",
            "default": "./src/main.ts"
        },
        "./vue": {
            "types": "./src/vue/main.ts",
            "default": "./src/vue/main.ts"
        }
    },
    "files": [
        "src"
    ],
    "sideEffects": [
        "**/*.vue"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "check": "vue-tsc --noEmit"
    },
    "prettier": "@greendrake/dev-config/prettier",
    "dependencies": {
        "@greendrake/scss-kit": "workspace:^",
        "@greendrake/util": "workspace:^"
    },
    "peerDependencies": {
        "vue": "^3.5.34"
    },
    "peerDependenciesMeta": {
        "vue": {
            "optional": true
        }
    },
    "devDependencies": {
        "@greendrake/dev-config": "workspace:*",
        "typescript": "6.0.3",
        "vue": "^3.5.34",
        "vue-tsc": "^2.2.0"
    }
}
