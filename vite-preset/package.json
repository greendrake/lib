{
    "name": "@greendrake/vite-preset",
    "version": "0.1.0",
    "description": "Vite config factory and build-env helpers for Vue 3 single-page apps: plugin set, strict dev port, alias, dedupe and source-package pre-bundling rules",
    "license": "MIT",
    "author": "Eugene Greendrake <eugene@greendrake.nz>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/greendrake/lib.git",
        "directory": "vite-preset"
    },
    "homepage": "https://github.com/greendrake/lib/tree/main/vite-preset#readme",
    "bugs": {
        "url": "https://github.com/greendrake/lib/issues"
    },
    "type": "module",
    "main": "src/main.ts",
    "types": "src/main.ts",
    "exports": {
        ".": {
            "types": "./src/main.ts",
            "default": "./src/main.ts"
        },
        "./api-target": {
            "types": "./src/apiTarget.ts",
            "default": "./src/apiTarget.ts"
        }
    },
    "files": [
        "src"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "check": "tsc --noEmit"
    },
    "prettier": "@greendrake/dev-config/prettier",
    "dependencies": {
        "@greendrake/util": "workspace:*",
        "@vitejs/plugin-vue": "^6.0.7",
        "html-minifier-terser": "^7.2.0"
    },
    "peerDependencies": {
        "vite": ">=8"
    },
    "devDependencies": {
        "@greendrake/dev-config": "workspace:*",
        "@types/bun": "^1.3.5",
        "@types/html-minifier-terser": "^7.0.2",
        "@types/node": "^24.0.0",
        "typescript": "6.0.3",
        "vite": "^8.2.1"
    }
}
