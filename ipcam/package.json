{
    "name": "@greendrake/ipcam",
    "version": "0.1.0",
    "description": "The browser end of the camera engine (greendrake.nz/go/ipcam): its API bound to a camera, the cameras' states, and the camera's tile and settings components",
    "license": "MIT",
    "author": "Eugene Greendrake <eugene@greendrake.nz>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/greendrake/lib.git",
        "directory": "ipcam"
    },
    "homepage": "https://github.com/greendrake/lib/tree/main/ipcam#readme",
    "bugs": {
        "url": "https://github.com/greendrake/lib/issues"
    },
    "type": "module",
    "main": "src/main.ts",
    "types": "src/main.ts",
    "exports": {
        ".": {
            "types": "./src/main.ts",
            "default": "./src/main.ts"
        }
    },
    "files": [
        "src"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "check": "vue-tsc --noEmit"
    },
    "prettier": "@greendrake/dev-config/prettier",
    "dependencies": {
        "@greendrake/mse-video": "workspace:^",
        "@greendrake/rpc": "workspace:^",
        "@greendrake/scss-kit": "workspace:^",
        "@greendrake/theme": "workspace:^",
        "@greendrake/ui": "workspace:^",
        "@greendrake/util": "workspace:^"
    },
    "peerDependencies": {
        "vue": "^3.5.34"
    },
    "devDependencies": {
        "@greendrake/dev-config": "workspace:*",
        "typescript": "6.0.3",
        "vue": "^3.5.34",
        "vue-tsc": "^2.2.0"
    }
}
